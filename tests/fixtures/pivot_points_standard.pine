//@version=6
indicator("Pivot Points Standard", "Pivots", overlay=true, max_lines_count=500, max_labels_count=500)
AUTO = "Auto"
DAILY = "Daily"
WEEKLY = "Weekly"
MONTHLY = "Monthly"
QUARTERLY = "Quarterly"
YEARLY = "Yearly"
BIYEARLY = "Biyearly"
TRIYEARLY = "Triyearly"
QUINQUENNIALLY = "Quinquennially"
DECENNIALLY = "Decennially"
TRADITIONAL = "Traditional"
FIBONACCI = "Fibonacci"
WOODIE = "Woodie"
CLASSIC = "Classic"
DEMARK = "DM"
CAMARILLA = "Camarilla"
kind = input.string(title="Type", defval="Traditional", options=[TRADITIONAL, FIBONACCI, WOODIE, CLASSIC, DEMARK, CAMARILLA])
pivot_time_frame = input.string(title="Pivots Timeframe", defval=AUTO, options=[AUTO, DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY, BIYEARLY, TRIYEARLY, QUINQUENNIALLY, DECENNIALLY])
look_back = input.int(title="Number of Pivots Back", defval=15, minval=1, maxval=5000, display = display.data_window)
is_daily_based = input.bool(title="Use Daily-based Values", defval=true, display = display.data_window)
show_labels = input.bool(title="Show Labels", defval=true, group="labels", display = display.data_window)
show_prices = input.bool(title="Show Prices", defval=true, group="labels", display = display.data_window)
position_labels = input.string("Left", "Labels Position", options=["Left", "Right"], group="labels", display = display.data_window)
line_width = input.int(title="Line Width", defval=1, minval=1, maxval=100, group="levels", display = display.data_window)
var DEF_COLOR = #FB8C00
p_color = input.color(DEF_COLOR, "P", inline="P", group="levels", display = display.data_window)
p_show = input.bool(true, "", inline="P", group="levels", display = display.data_window)
s1_color = input.color(DEF_COLOR, "S1", inline="S1/R1" , group="levels", display = display.data_window)
s1_show = input.bool(true, "", inline="S1/R1", group="levels", display = display.data_window)
r1_color = input.color(DEF_COLOR, "R1", inline="S1/R1", group="levels", display = display.data_window)
r1_show = input.bool(true, "", inline="S1/R1", group="levels", display = display.data_window)
s2_color = input.color(DEF_COLOR, "S2", inline="S2/R2", group="levels", display = display.data_window)
s2_show = input.bool(true, "", inline="S2/R2", group="levels", display = display.data_window)
r2_color = input.color(DEF_COLOR, "R2", inline="S2/R2", group="levels", display = display.data_window)
r2_show = input.bool(true, "", inline="S2/R2", group="levels", display = display.data_window)
s3_color = input.color(DEF_COLOR, "S3", inline="S3/R3", group="levels", display = display.data_window)
s3_show = input.bool(true, "", inline="S3/R3", group="levels", display = display.data_window)
r3_color = input.color(DEF_COLOR, "R3", inline="S3/R3", group="levels", display = display.data_window)
r3_show = input.bool(true, "", inline="S3/R3", group="levels", display = display.data_window)
s4_color = input.color(DEF_COLOR, "S4", inline="S4/R4", group="levels", display = display.data_window)
s4_show = input.bool(true, "", inline="S4/R4", group="levels", display = display.data_window)
r4_color = input.color(DEF_COLOR, "R4", inline="S4/R4", group="levels", display = display.data_window)
r4_show = input.bool(true, "", inline="S4/R4", group="levels", display = display.data_window)
s5_color = input.color(DEF_COLOR, "S5", inline="S5/R5", group="levels", display = display.data_window)
s5_show = input.bool(true, "", inline="S5/R5", group="levels", display = display.data_window)
r5_color = input.color(DEF_COLOR, "R5", inline="S5/R5", group="levels", display = display.data_window)
r5_show = input.bool(true, "", inline="S5/R5", group="levels", display = display.data_window)

type graphicSettings
    string levelName
    color levelColor
    bool showLevel

var graphicSettingsArray = array.from(
      graphicSettings.new(" P", p_color, p_show),
      graphicSettings.new("R1", r1_color, r1_show), graphicSettings.new("S1", s1_color, s1_show),
      graphicSettings.new("R2", r2_color, r2_show), graphicSettings.new("S2", s2_color, s2_show),
      graphicSettings.new("R3", r3_color, r3_show), graphicSettings.new("S3", s3_color, s3_show),
      graphicSettings.new("R4", r4_color, r4_show), graphicSettings.new("S4", s4_color, s4_show),
      graphicSettings.new("R5", r5_color, r5_show), graphicSettings.new("S5", s5_color, s5_show))

autoAnchor = switch
    timeframe.isintraday => timeframe.multiplier <= 15 ? "1D" : "1W"
    timeframe.isdaily    => "1M"
    => "12M"

pivotTimeframe = switch pivot_time_frame
    AUTO      => autoAnchor
    DAILY     => "1D"
    WEEKLY    => "1W"
    MONTHLY   => "1M"
    QUARTERLY => "3M"
    => "12M"

pivotYearMultiplier = switch pivot_time_frame
    BIYEARLY       => 2
    TRIYEARLY      => 3
    QUINQUENNIALLY => 5
    DECENNIALLY    => 10
    => 1

numOfPivotLevels = switch kind
    TRADITIONAL => 11
    CAMARILLA   => 11
    WOODIE      => 9
    CLASSIC     => 9
    DEMARK      => 3
    => 7

type pivotGraphic
    line pivotLine
    label pivotLabel

method delete(pivotGraphic graphic) =>
    graphic.pivotLine.delete()
    graphic.pivotLabel.delete()

var drawnGraphics = matrix.new<pivotGraphic>()

localPivotTimeframeChange = timeframe.change(pivotTimeframe) and year % pivotYearMultiplier == 0
securityPivotTimeframeChange = timeframe.change(timeframe.period) and year % pivotYearMultiplier == 0

pivotTimeframeChangeCounter(condition) =>
    var count = 0
    if condition and bar_index > 0
        count += 1
    count

localPivots = ta.pivot_point_levels(kind, localPivotTimeframeChange)
securityPivotPointsArray = ta.pivot_point_levels(kind, securityPivotTimeframeChange)

securityTimeframe = timeframe.isintraday ? "1D" : timeframe.period
[securityPivots, securityPivotCounter] = request.security(syminfo.tickerid, pivotTimeframe, [securityPivotPointsArray, pivotTimeframeChangeCounter(securityPivotTimeframeChange)], lookahead = barmerge.lookahead_on)
pivotPointsArray = is_daily_based ? securityPivots : localPivots

affixOldPivots(endTime) =>
    if drawnGraphics.rows() > 0
        lastGraphics = drawnGraphics.row(drawnGraphics.rows() - 1)
        for graphic in lastGraphics
            graphic.pivotLine.set_x2(endTime)
            if position_labels == "Right"
                graphic.pivotLabel.set_x(endTime)

drawNewPivots(startTime) =>
    newGraphic = array.new<pivotGraphic>()
    for [index, coord] in pivotPointsArray
        levelSettings = graphicSettingsArray.get(index)
        if not na(coord) and levelSettings.showLevel
            lineEndTime = startTime + timeframe.in_seconds(pivotTimeframe) * 1000 * pivotYearMultiplier
            pivotLine = line.new(startTime, coord, lineEndTime, coord, xloc = xloc.bar_time, color=levelSettings.levelColor, width=line_width)
            pivotLabel = label.new(x = position_labels == "Left" ? startTime : lineEndTime, y = coord, text = (show_labels ? levelSettings.levelName : "") + (show_prices ? " (" + str.tostring(coord, format.mintick) + ")" : ""), style = position_labels == "Left" ? label.style_label_right : label.style_label_left, textcolor = levelSettings.levelColor, color = #00000000, xloc=xloc.bar_time)
            newGraphic.push(pivotGraphic.new(pivotLine, pivotLabel))
    drawnGraphics.add_row(array_id = newGraphic)
    if drawnGraphics.rows() > look_back
        oldGraphics = drawnGraphics.remove_row(0)
        for graphic in oldGraphics
            graphic.delete()

localPivotDrawConditionStatic = not is_daily_based and localPivotTimeframeChange
securityPivotDrawConditionStatic = is_daily_based and securityPivotCounter != securityPivotCounter[1]

if (securityPivotDrawConditionStatic or localPivotDrawConditionStatic)
    affixOldPivots(time)
    drawNewPivots(time)

var FIRST_BAR_TIME = time
if (barstate.islastconfirmedhistory and drawnGraphics.columns() == 0)
    if not na(securityPivots) and securityPivotCounter > 0
        if is_daily_based
            drawNewPivots(FIRST_BAR_TIME)
        else
            runtime.error("Not enough intraday data to calculate Pivot Points. Lower the Pivots Timeframe or turn on the 'Use Daily-based Values' option in the indicator settings.")
    else
        runtime.error("Not enough data available for pivot point calculation. Select a lower timeframe from the options in the 'Pivots timeframe' input.")
