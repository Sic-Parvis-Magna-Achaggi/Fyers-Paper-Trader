[Unit]
Description=Fyers trade manager helper
After=network-online.target
Wants=network-online.target

[Service]
User=helper
Group=helper
WorkingDirectory=/home/helper/app
Environment=FYERS_HELPER_DATA=/home/helper/data
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/fyers/server.conf
ExecStart=/home/helper/venv/bin/uvicorn helper.app:app --host 127.0.0.1 --port 8000 --no-server-header
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
